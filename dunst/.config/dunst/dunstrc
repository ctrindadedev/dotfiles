# Notificações (paleta Catppuccin Mocha, igual à polybar)
[global]
    monitor = 0
    follow = mouse
    width = (280, 380)
    height = 120
    origin = top-right
    offset = 16x48
    notification_limit = 5
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "#313244"
    corner_radius = 12
    separator_color = frame
    font = FiraCode Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 250
    progress_bar_max_width = 350
    progress_bar_corner_radius = 4
    highlight = "#CBA6F7"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1E1E2EE6"
    foreground = "#CDD6F4"
    timeout = 3

[urgency_normal]
    background = "#1E1E2EE6"
    foreground = "#CDD6F4"
    timeout = 6

[urgency_critical]
    background = "#1E1E2EE6"
    foreground = "#CDD6F4"
    frame_color = "#F38BA8"
    highlight = "#F38BA8"
    timeout = 0

# OSD de volume/brilho: substitui o anterior em vez de empilhar, some rápido
[osd]
    stack_tag = "osd"
    timeout = 1500ms
    urgency = low
