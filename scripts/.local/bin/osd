#!/bin/sh
# Volume e brilho com feedback visual (dunst).
# Uso: osd volume {up|down|mute} | osd mic | osd brightness {up|down}

notify() { # $1 ícone, $2 título, $3 valor 0-100
    notify-send -u low -i "$1" -h string:x-dunst-stack-tag:osd -h "int:value:$3" "$2" "" 2>/dev/null
}

case "$1" in
    volume)
        case "$2" in
            up) # para em 100% (acima disso distorce)
                pactl set-sink-mute @DEFAULT_SINK@ 0
                cur=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1 | tr -d %)
                if [ "$cur" -ge 95 ]; then pactl set-sink-volume @DEFAULT_SINK@ 100%; else pactl set-sink-volume @DEFAULT_SINK@ +5%; fi ;;
            down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
            mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
        esac
        vol=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1 | tr -d %)
        if pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes; then
            notify audio-volume-muted "Mudo" 0
        else
            notify audio-volume-high "Volume ${vol}%" "$vol"
        fi
        ;;
    mic)
        pactl set-source-mute @DEFAULT_SOURCE@ toggle
        if pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes; then
            notify microphone-sensitivity-muted "Microfone mudo" 0
        else
            notify microphone-sensitivity-high "Microfone ligado" 100
        fi
        ;;
    brightness)
        case "$2" in
            up)   brightnessctl -q set +5% ;;
            down) brightnessctl -q set 5%- ;;
        esac
        pct=$(brightnessctl -m | cut -d, -f4 | tr -d %)
        notify display-brightness "Brilho ${pct}%" "$pct"
        ;;
esac
