#!/bin/sh
# Vigia o cabo HDMI: ao plugar abre o menu de telas, ao desplugar volta pro notebook.
# Lê o status direto do kernel a cada 2s (custo praticamente zero).
status() { cat /sys/class/drm/card*-HDMI-A-*/status 2>/dev/null | grep -qx connected && echo on || echo off; }

last=$(status)
while sleep 2; do
    now=$(status)
    [ "$now" = "$last" ] && continue
    last=$now
    sleep 1 # dá tempo do monitor terminar de negociar a resolução
    if [ "$now" = on ]; then
        ~/.local/bin/display-menu
    else
        ~/.local/bin/display-menu laptop
    fi
done
