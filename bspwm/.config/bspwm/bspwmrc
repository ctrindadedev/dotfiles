#! /bin/sh
# Este arquivo roda de novo a cada Super+Esc, então tudo aqui precisa ser idempotente.

# 1. Monitores
# Mirror vira um monitor só; monitor desplugado/desligado devolve os desktops ao notebook
bspc config merge_overlapping_monitors true
bspc config remove_unplugged_monitors  true
bspc config remove_disabled_monitors   true

# Perfil salvo do autorandr se houver; senão estende pra direita quando o HDMI estiver plugado
if ! { command -v autorandr >/dev/null && autorandr --change >/dev/null 2>&1; }; then
    if xrandr --query | grep -q '^HDMI-A-0 connected'; then
        xrandr --output eDP --primary --auto --output HDMI-A-0 --auto --right-of eDP
    else
        xrandr --output eDP --primary --auto --output HDMI-A-0 --off
    fi
fi

# 2. Teclado
pgrep -x sxhkd > /dev/null || sxhkd &

# 3. Espaços de trabalho: 1-5 no notebook, 6-10 no HDMI (ou todos no notebook sem HDMI)
~/.local/bin/display-menu --fix

# Configurações visuais do bspwm
bspc config border_width         2
bspc config window_gap          12
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# 4. Bandeja do Sistema e daemons
killall -q nm-applet flameshot pasystray
pgrep -f polkit-gnome-authentication-agent-1 > /dev/null || /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &
nm-applet &
flameshot &
pasystray &

# Notificações (sem isso nenhum aviso aparece na tela)
command -v dunst > /dev/null && { pgrep -x dunst > /dev/null || dunst & }

# Bateria fraca, tampa e suspensão. As teclas de brilho ficam com o sxhkd (evita passo duplo)
if command -v xfce4-power-manager > /dev/null; then
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/handle-brightness-keys -n -t bool -s false 2>/dev/null
    pgrep -x xfce4-power-man > /dev/null || xfce4-power-manager &
fi

# 5. Polybar: iniciada pelo display-menu --fix acima

# 6. Picom (Transparências e Bordas)
killall -q picom
picom -b &

# 7. Wallpaper (Imagem estática)
feh --bg-fill ~/Downloads/Wallpapers/drag_walp.jpg &

# Regras (remove as antigas primeiro pra não acumular a cada reload)
bspc rule -r '*'
bspc rule -a Steam state=floating
bspc rule -a "steam_app_*" state=fullscreen
bspc rule -a "gamescope" state=fullscreen
bspc rule -a Plank manage=off border=off
